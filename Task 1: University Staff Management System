
#include <iostream>
#include <string>
using namespace std;

// General binary tree node
class Node {
public:
    string name;
    Node* left;
    Node* right;

    Node(string n) {
        name = n;
        left = nullptr;
        right = nullptr;
    }
};

// General binary tree
class GeneralBinaryTree {
public:
    Node* root;

    GeneralBinaryTree() {
        root = nullptr;
    }

    void display(Node* node) {
        if (node == nullptr)
            return;

        cout << "Staff: " << node->name << endl;

        cout << "Left child: ";
        if (node->left != nullptr)
            cout << node->left->name;
        else
            cout << "NULL";

        cout << "\nRight child: ";
        if (node->right != nullptr)
            cout << node->right->name;
        else
            cout << "NULL";

        cout << "\n\n";

        display(node->left);
        display(node->right);
    }

    void destroy(Node* node) {
        if (node == nullptr)
            return;

        destroy(node->left);
        destroy(node->right);
        delete node;
    }

    ~GeneralBinaryTree() {
        destroy(root);
    }
};

// BST node for staff IDs
class BSTNode {
public:
    int id;
    BSTNode* left;
    BSTNode* right;

    BSTNode(int value) {
        id = value;
        left = nullptr;
        right = nullptr;
    }
};

class BST {
private:
    BSTNode* root;

    BSTNode* insert(BSTNode* node, int id,
                    bool& inserted) {
        if (node == nullptr) {
            inserted = true;
            return new BSTNode(id);
        }

        if (id < node->id)
            node->left = insert(node->left, id, inserted);
        else if (id > node->id)
            node->right = insert(node->right, id, inserted);
        else
            inserted = false;

        return node;
    }

    bool search(BSTNode* node, int id, int& visits) const {
        if (node == nullptr)
            return false;

        visits++;

        if (node->id == id)
            return true;

        if (id < node->id)
            return search(node->left, id, visits);

        return search(node->right, id, visits);
    }

    BSTNode* findMin(BSTNode* node) {
        while (node != nullptr && node->left != nullptr)
            node = node->left;

        return node;
    }

    BSTNode* deleteNode(BSTNode* node, int id,
                        bool& deleted) {
        if (node == nullptr)
            return nullptr;

        if (id < node->id)
            node->left = deleteNode(node->left, id, deleted);
        else if (id > node->id)
            node->right = deleteNode(node->right, id, deleted);
        else {
            deleted = true;

            // Case 1 and 2: leaf or one child
            if (node->left == nullptr) {
                BSTNode* child = node->right;
                delete node;
                return child;
            }

            if (node->right == nullptr) {
                BSTNode* child = node->left;
                delete node;
                return child;
            }

            // Case 3: two children
            BSTNode* successor = findMin(node->right);
            node->id = successor->id;

            bool ignored = false;
            node->right = deleteNode(
                node->right, successor->id, ignored
            );
        }

        return node;
    }

    void inorder(BSTNode* node) const {
        if (node == nullptr)
            return;

        inorder(node->left);
        cout << node->id << " ";
        inorder(node->right);
    }

    void destroy(BSTNode* node) {
        if (node == nullptr)
            return;

        destroy(node->left);
        destroy(node->right);
        delete node;
    }

public:
    BST() {
        root = nullptr;
    }

    ~BST() {
        destroy(root);
    }

    bool insertID(int id) {
        bool inserted = false;
        root = insert(root, id, inserted);
        return inserted;
    }

    void searchID(int id) const {
        int visits = 0;
        bool found = search(root, id, visits);

        if (found)
            cout << "ID exists.";
        else
            cout << "ID does not exist.";

        cout << " Node visits: " << visits << endl;
    }

    bool deleteID(int id) {
        bool deleted = false;
        root = deleteNode(root, id, deleted);
        return deleted;
    }

    void displayAscending() const {
        cout << "Staff IDs in ascending order: ";
        inorder(root);
        cout << endl;
    }
};

// Test deletion using a fresh original BST
void testDeletion(const string& label,
                  int id, int prepareDelete = -1) {
    BST tree;

    int ids[] = {48, 28, 68, 18, 38, 58, 78};

    for (int value : ids)
        tree.insertID(value);

    if (prepareDelete != -1)
        tree.deleteID(prepareDelete);

    cout << "\n" << label << ", deleting " << id << endl;

    if (tree.deleteID(id))
        cout << "Deletion successful.\n";
    else
        cout << "ID not found.\n";

    tree.displayAscending();
}

int main() {
    cout << "UNIVERSITY STAFF MANAGEMENT SYSTEM\n\n";

    // Seven staff members in a general binary tree
    GeneralBinaryTree staff;

    staff.root = new Node("Ayesha");
    staff.root->left = new Node("Bilal");
    staff.root->right = new Node("Hassan");
    staff.root->left->left = new Node("Fatima");
    staff.root->left->right = new Node("Usman");
    staff.root->right->left = new Node("Sara");
    staff.root->right->right = new Node("Ali");

    cout << "--- General Binary Tree ---\n";
    staff.display(staff.root);

    // Initial BST
    BST tree;
    int ids[] = {48, 28, 68, 18, 38, 58, 78};

    for (int id : ids)
        tree.insertID(id);

    // Insert three additional IDs
    cout << "--- Add Three Staff IDs ---\n";

    for (int i = 1; i <= 3; i++) {
        int id;
        cout << "Enter additional ID " << i << ": ";
        cin >> id;

        if (tree.insertID(id))
            cout << "ID inserted.\n";
        else
            cout << "Duplicate ID rejected.\n";
    }

    tree.displayAscending();

    // Search tests
    int id;

    cout << "\n--- Search Existing ID ---\n";
    cout << "Enter an existing ID (e.g. 48): ";
    cin >> id;
    tree.searchID(id);

    cout << "\n--- Search Missing ID ---\n";
    cout << "Enter a missing ID: ";
    cin >> id;
    tree.searchID(id);

    cout << "\n--- Search ID Smaller Than All IDs ---\n";
    cout << "Enter an ID smaller than all registered IDs: ";
    cin >> id;
    tree.searchID(id);

    // User-selected deletion
    cout << "\n--- Delete a Staff ID ---\n";
    cout << "Enter ID to delete: ";
    cin >> id;

    if (tree.deleteID(id))
        cout << "ID deleted successfully.\n";
    else
        cout << "ID not found.\n";

    tree.displayAscending();

    // Separate deletion cases on fresh BSTs
    cout << "\n--- Deletion Case Tests ---\n";

    testDeletion("Leaf node", 18);

    // Delete 18 first, making 28 a one-child node
    testDeletion("One-child node", 28, 18);

    testDeletion("Two-child node", 48);

    cout << "\nExplanation:\n";
    cout << "A general binary tree has no sorting rule.\n";
    cout << "A BST stores smaller IDs on the left and larger IDs "
            "on the right.\n";
    cout << "Therefore, BST in-order traversal displays IDs "
            "in ascending order.\n";

    return 0;
}
