
#include <iostream>
using namespace std;

class Node {
public:
    int id;
    Node* left;
    Node* right;

    Node(int value) {
        id = value;
        left = nullptr;
        right = nullptr;
    }
};

class BST {
private:
    Node* root;

    Node* insert(Node* node, int id, bool& inserted) {
        if (node == nullptr) {
            inserted = true;
            return new Node(id);
        }

        if (id < node->id)
            node->left = insert(node->left, id, inserted);
        else if (id > node->id)
            node->right = insert(node->right, id, inserted);
        else
            inserted = false;

        return node;
    }

    bool search(Node* node, int id) const {
        if (node == nullptr)
            return false;

        if (node->id == id)
            return true;

        if (id < node->id)
            return search(node->left, id);

        return search(node->right, id);
    }

    Node* findMin(Node* node) {
        while (node != nullptr && node->left != nullptr)
            node = node->left;

        return node;
    }

    Node* deleteNode(Node* node, int id, bool& deleted) {
        if (node == nullptr)
            return nullptr;

        if (id < node->id) {
            node->left = deleteNode(node->left, id, deleted);
        }
        else if (id > node->id) {
            node->right = deleteNode(node->right, id, deleted);
        }
        else {
            deleted = true;

            // Leaf or one child
            if (node->left == nullptr) {
                Node* child = node->right;
                delete node;
                return child;
            }

            if (node->right == nullptr) {
                Node* child = node->left;
                delete node;
                return child;
            }

            // Two children: use in-order successor
            Node* successor = findMin(node->right);
            node->id = successor->id;

            bool ignored = false;
            node->right = deleteNode(
                node->right, successor->id, ignored
            );
        }

        return node;
    }

    void inorder(Node* node) const {
        if (node == nullptr)
            return;

        inorder(node->left);
        cout << node->id << " ";
        inorder(node->right);
    }

    void preorder(Node* node) const {
        if (node == nullptr)
            return;

        cout << node->id << " ";
        preorder(node->left);
        preorder(node->right);
    }

    void postorder(Node* node) const {
        if (node == nullptr)
            return;

        postorder(node->left);
        postorder(node->right);
        cout << node->id << " ";
    }

    int countNodes(Node* node) const {
        if (node == nullptr)
            return 0;

        return 1 + countNodes(node->left)
                 + countNodes(node->right);
    }

    // Height is measured in levels
    int height(Node* node) const {
        if (node == nullptr)
            return 0;

        int leftHeight = height(node->left);
        int rightHeight = height(node->right);

        if (leftHeight > rightHeight)
            return 1 + leftHeight;

        return 1 + rightHeight;
    }

    void destroy(Node* node) {
        if (node == nullptr)
            return;

        destroy(node->left);
        destroy(node->right);
        delete node;
    }

public:
    BST() {
        root = nullptr;
    }

    ~BST() {
        destroy(root);
    }

    bool isEmpty() const {
        return root == nullptr;
    }

    bool insertID(int id) {
        bool inserted = false;
        root = insert(root, id, inserted);
        return inserted;
    }

    void searchID(int id) const {
        if (search(root, id))
            cout << "ID found.\n";
        else
            cout << "ID not found.\n";
    }

    bool deleteID(int id) {
        bool deleted = false;
        root = deleteNode(root, id, deleted);
        return deleted;
    }

    void displayInorder() const {
        if (isEmpty()) {
            cout << "Tree is empty.\n";
            return;
        }

        cout << "In-order: ";
        inorder(root);
        cout << endl;
    }

    void displayPreorder() const {
        if (isEmpty()) {
            cout << "Tree is empty.\n";
            return;
        }

        cout << "Pre-order: ";
        preorder(root);
        cout << endl;
    }

    void displayPostorder() const {
        if (isEmpty()) {
            cout << "Tree is empty.\n";
            return;
        }

        cout << "Post-order: ";
        postorder(root);
        cout << endl;
    }

    void displayCount() const {
        cout << "Total nodes: " << countNodes(root) << endl;
    }

    void displayHeight() const {
        cout << "Tree height (levels): "
             << height(root) << endl;
    }
};

int main() {
    BST tree;

    // Required initial IDs
    int ids[] = {55, 35, 75, 25, 45, 65, 85, 40, 50};

    for (int id : ids)
        tree.insertID(id);

    cout << "HOSPITAL AND EMERGENCY INVENTORY SYSTEM\n";
    cout << "Initial BST created successfully.\n";

    int choice;

    do {
        cout << "\n========== MENU ==========\n";
        cout << "1. Insert an ID\n";
        cout << "2. Search for an ID\n";
        cout << "3. Delete an ID\n";
        cout << "4. Display in-order traversal\n";
        cout << "5. Display pre-order traversal\n";
        cout << "6. Display post-order traversal\n";
        cout << "7. Count total nodes\n";
        cout << "8. Calculate tree height\n";
        cout << "9. Exit\n";
        cout << "Enter choice: ";

        if (!(cin >> choice)) {
            cout << "Invalid input. Enter a number from 1 to 9.\n";
            cin.clear();
            cin.ignore(10000, '\n');
            continue;
        }

        int id;

        switch (choice) {
        case 1:
            cout << "Enter ID to insert: ";
            if (!(cin >> id)) {
                cout << "Invalid ID.\n";
                cin.clear();
                cin.ignore(10000, '\n');
                break;
            }

            if (tree.insertID(id))
                cout << "ID inserted successfully.\n";
            else
                cout << "Duplicate ID rejected.\n";
            break;

        case 2:
            cout << "Enter ID to search: ";
            if (!(cin >> id)) {
                cout << "Invalid ID.\n";
                cin.clear();
                cin.ignore(10000, '\n');
                break;
            }

            tree.searchID(id);
            break;

        case 3:
            cout << "Enter ID to delete: ";
            if (!(cin >> id)) {
                cout << "Invalid ID.\n";
                cin.clear();
                cin.ignore(10000, '\n');
                break;
            }

            if (tree.deleteID(id)) {
                cout << "ID deleted successfully.\n";
                tree.displayInorder();
            }
            else {
                cout << "ID not found; tree unchanged.\n";
            }
            break;

        case 4:
            tree.displayInorder();
            break;

        case 5:
            tree.displayPreorder();
            break;

        case 6:
            tree.displayPostorder();
            break;

        case 7:
            tree.displayCount();
            break;

        case 8:
            tree.displayHeight();
            break;

        case 9:
            cout << "Exiting program.\n";
            break;

        default:
            cout << "Invalid choice. Enter 1 to 9.\n";
        }

    } while (choice != 9);

    return 0;
}
