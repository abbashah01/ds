#include <iostream>
using namespace std;

const int SIZE = 5;
int q[SIZE], front = -1, rear = -1;

void enqueue(int x) {
    if (rear == SIZE - 1) {
        cout << "Queue Overflow\n";
        return;
    }
    if (front == -1) front = 0;
    q[++rear] = x;
}

void dequeue() {
    if (front == -1) {
        cout << "Queue Underflow\n";
        return;
    }
    cout << "Served: " << q[front++] << '\n';
    if (front > rear) front = rear = -1;
}

void display() {
    if (front == -1) {
        cout << "No waiting customers\n";
        return;
    }
    for (int i = front; i <= rear; i++)
        cout << q[i] << " ";
    cout << "\nWaiting: " << rear - front + 1 << '\n';
}

int main() {
    enqueue(101);
    enqueue(102);
    enqueue(103);
    display();
    dequeue();
    display();
    return 0;
}
